{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "security_architecture.schema.json",
  "title": "security_architecture.json",
  "description": "Schema for .ai/blueteam/data/security_architecture.json produced by security_architecture_design_skill. Fields marked required are consumed by generate_overview_html.py to render the Security Architecture tab.",
  "type": "object",
  "required": [
    "schema_version",
    "last_updated",
    "assessment_name",
    "application_name",
    "mode",
    "profile",
    "profile_confidence",
    "gaps"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version string, e.g. \"1.0\""
    },
    "last_updated": {
      "type": "string",
      "description": "ISO 8601 date of last write (YYYY-MM-DD)"
    },
    "assessment_name": {
      "type": "string",
      "const": "security_architecture_design",
      "description": "Must be exactly 'security_architecture_design'"
    },
    "application_name": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": ["full", "describe", "design", "minimal"],
      "description": "Operating mode determined by available inputs"
    },
    "profile": {
      "type": "string",
      "enum": ["internal", "public", "dual", "custom", "unknown"],
      "description": "Identified organizational deployment profile"
    },
    "profile_confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "Confidence level for profile assignment"
    },
    "profile_basis": {
      "type": "string",
      "description": "Evidence summary for profile assignment"
    },
    "data_classification": {
      "type": "string",
      "enum": ["public", "protected_a", "protected_b", "unknown"]
    },
    "auth": {
      "type": "object",
      "properties": {
        "drivers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "session_store": { "type": ["string", "null"] },
        "mfa_required": { "type": ["boolean", "null"] },
        "citizen_auth": { "type": "boolean" },
        "jwt_for_user_sessions": { "type": "boolean" }
      }
    },
    "authorization": {
      "type": "object",
      "properties": {
        "roles_defined_in_requirements": {
          "type": "array",
          "items": { "type": "string" }
        },
        "roles_found_in_code": {
          "type": "array",
          "items": { "type": "string" }
        },
        "enforcement_pattern": { "type": ["string", "null"] },
        "per_object_auth": {
          "type": "string",
          "enum": ["present", "absent", "partial", "not_required", "unknown"]
        }
      }
    },
    "data_protection": {
      "type": "object",
      "properties": {
        "encryption_in_transit": {
          "type": "string",
          "enum": ["enforced", "not_enforced", "unknown"]
        },
        "encryption_at_rest": { "type": "string" },
        "field_level_encryption": {
          "type": "string",
          "enum": ["present", "absent", "not_required", "unknown"]
        },
        "secrets_management": {
          "type": "string",
          "enum": ["key_vault", "environment_vars", "hardcoded", "unknown"]
        }
      }
    },
    "perimeter": {
      "type": "object",
      "properties": {
        "api_gateway_required": { "type": "boolean" },
        "api_gateway_found": { "type": ["string", "null"] },
        "bff_pattern": {
          "type": "string",
          "enum": ["present", "absent", "unknown"]
        },
        "rate_limiting": {
          "type": "string",
          "enum": ["global", "auth_only", "absent", "unknown"]
        },
        "security_headers": {
          "type": "string",
          "enum": ["present", "partial", "absent", "unknown"]
        }
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "structured_logging": {
          "type": "string",
          "enum": ["present", "absent", "unknown"]
        },
        "pii_redaction": {
          "type": "string",
          "enum": ["present", "absent", "unknown"]
        },
        "correlation_ids": {
          "type": "string",
          "enum": ["present", "absent", "unknown"]
        },
        "audit_logging": {
          "type": "string",
          "enum": ["present", "partial", "absent", "unknown"]
        }
      }
    },
    "gaps": {
      "type": "array",
      "description": "Architectural gap findings rendered in Security Architecture tab. IDs must follow SA-NNN format.",
      "items": {
        "type": "object",
        "required": ["id", "category", "severity", "title", "description", "evidence", "recommendation"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SA-\\d+",
            "description": "Gap identifier, e.g. SA-001"
          },
          "category": {
            "type": "string",
            "enum": [
              "profile",
              "authentication",
              "authorization_model",
              "data_protection",
              "perimeter",
              "logging",
              "api_architecture"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" },
          "references": {
            "type": "array",
            "items": { "type": "string" }
          },
          "related_requirement_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["open", "risk_accepted"]
          }
        }
      }
    }
  }
}
