{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "application_map.schema.json",
  "title": "application_map.json",
  "description": "Schema for .ai/blueteam/data/application_map.json — point-in-time codebase security snapshot written by skills/01-application-map.md",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at_date",
    "generated_at_commit",
    "has_git_history",
    "application_name",
    "tech_stack",
    "identity_providers",
    "auth_mechanisms",
    "endpoints",
    "critical_files",
    "secrets_findings",
    "bot_commits",
    "gitignore_gaps",
    "client_applications"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version string, e.g. \"1.0\""
    },
    "generated_at_date": {
      "type": "string",
      "description": "ISO 8601 date of map generation (YYYY-MM-DD)"
    },
    "generated_at_commit": {
      "type": ["string", "null"],
      "description": "40-character SHA-1 from git rev-parse HEAD, or null for non-git repos"
    },
    "has_git_history": {
      "type": "boolean",
      "description": "True if .git/ directory exists and history was scanned"
    },
    "application_name": {
      "type": "string",
      "description": "Inferred from classification YAML, package.json name, or repo directory name"
    },
    "tech_stack": {
      "type": "object",
      "description": "Technology stack details",
      "required": [
        "primary_language",
        "uses_managed_language",
        "deployment_target_inferred"
      ],
      "additionalProperties": true,
      "properties": {
        "primary_language": {
          "type": "string"
        },
        "secondary_languages": {
          "type": "array",
          "items": { "type": "string" }
        },
        "frameworks": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runtime": {
          "type": "string"
        },
        "package_manager": {
          "type": "string"
        },
        "uses_managed_language": {
          "type": "boolean",
          "description": "True if primary language is managed/memory-safe (TypeScript, Python, Go, Java, C#, Ruby)"
        },
        "has_file_uploads": {
          "type": "boolean"
        },
        "has_ai_llm_features": {
          "type": "boolean"
        },
        "ai_llm_details": {
          "type": ["string", "null"]
        },
        "deployment_manifests_found": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deployment_target_inferred": {
          "type": "string",
          "enum": ["cloud_lz", "on_premises", "unknown"],
          "description": "Inferred deployment target"
        }
      }
    },
    "identity_providers": {
      "type": "array",
      "description": "All detected IdP integrations; empty array if none found",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "type": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "notes": { "type": "string" }
        }
      }
    },
    "auth_mechanisms": {
      "type": "array",
      "description": "All detected authentication mechanisms; empty array if none found",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": true,
        "properties": {
          "type": {
            "type": "string",
            "description": "JWT | Session | API Key | OAuth/OIDC | Basic | None"
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "signature_verified": { "type": "boolean" },
          "algorithm_hardened": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "description": "All detected routes/API endpoints — REST, GraphQL, WebSocket, SSE, webhook",
      "items": {
        "type": "object",
        "required": ["path", "auth_level"],
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string" },
          "methods": {
            "type": "array",
            "items": { "type": "string" }
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "resource_group": {
            "type": "string",
            "description": "Normalized resource path used to group endpoints by resource for authorization uniformity checks"
          },
          "auth_level": {
            "type": "string",
            "enum": ["authenticated", "unauthenticated", "unknown"]
          },
          "auth_middleware": {
            "type": "array",
            "items": { "type": "string" }
          },
          "auth_first_in_chain": {
            "type": ["boolean", "null"],
            "description": "True if auth middleware precedes all other middleware; null if ordering cannot be determined"
          },
          "uses_elevated_credentials": {
            "type": "boolean",
            "description": "True if endpoint uses service role keys, admin API keys, or privileged credentials"
          },
          "consumes_protected_data": { "type": "boolean" },
          "protected_data_classification": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "critical_files": {
      "type": "object",
      "description": "Categorized lists of security-critical files; all arrays may be empty but keys must be present",
      "required": [
        "authentication",
        "authorization",
        "routing",
        "configuration",
        "data_models",
        "encryption",
        "logging",
        "file_uploads",
        "ai_llm",
        "deployment"
      ],
      "additionalProperties": true,
      "properties": {
        "authentication": { "type": "array", "items": { "type": "string" } },
        "authorization":  { "type": "array", "items": { "type": "string" } },
        "routing":        { "type": "array", "items": { "type": "string" } },
        "configuration":  { "type": "array", "items": { "type": "string" } },
        "data_models":    { "type": "array", "items": { "type": "string" } },
        "encryption":     { "type": "array", "items": { "type": "string" } },
        "logging":        { "type": "array", "items": { "type": "string" } },
        "file_uploads":   { "type": "array", "items": { "type": "string" } },
        "ai_llm":         { "type": "array", "items": { "type": "string" } },
        "deployment":     { "type": "array", "items": { "type": "string" } }
      }
    },
    "secrets_findings": {
      "type": "array",
      "description": "Detected secrets; empty array if none found",
      "items": {
        "type": "object",
        "required": ["id", "type", "file", "severity", "location"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "location": {
            "type": "string",
            "enum": ["current_head", "history_only"]
          },
          "commit_hash": { "type": ["string", "null"] },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "detection_method": { "type": "string" },
          "tool_used": { "type": "string" },
          "redacted_preview": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "bot_commits": {
      "type": "array",
      "description": "Bot-authored commits detected; empty array if none",
      "items": {
        "type": "object",
        "required": ["commit_hash", "author", "date", "review_evidence"],
        "additionalProperties": true,
        "properties": {
          "commit_hash": { "type": "string" },
          "author": { "type": "string" },
          "date": { "type": "string" },
          "security_critical_files_touched": {
            "type": "array",
            "items": { "type": "string" }
          },
          "review_evidence": {
            "type": "string",
            "enum": ["reviewed", "unreviewed", "unknown"]
          }
        }
      }
    },
    "gitignore_gaps": {
      "type": "array",
      "description": "Missing .gitignore entries for sensitive patterns; empty array if none",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "sensitive_pattern": { "type": "string" },
          "files_matched": {
            "type": "array",
            "items": { "type": "string" }
          },
          "any_committed": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "client_applications": {
      "type": "array",
      "description": "All detected client-side application packages; empty array if none",
      "items": {
        "type": "object",
        "required": ["name", "type", "credential_storage", "credential_storage_encrypted"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["mobile-rn", "web-spa", "cli"]
          },
          "path": { "type": "string" },
          "framework": { "type": "string" },
          "framework_version": { "type": "string" },
          "auth_mechanisms": {
            "type": "array",
            "items": { "type": "string" }
          },
          "credential_storage": { "type": "string" },
          "credential_storage_encrypted": { "type": "boolean" },
          "os_permissions_declared": {
            "type": "array",
            "items": { "type": "string" }
          },
          "attestation_present": { "type": "boolean" },
          "certificate_pinning": { "type": "boolean" },
          "pii_in_local_state": {
            "type": "array",
            "items": { "type": "string" }
          },
          "deep_link_scheme": { "type": ["string", "null"] },
          "critical_files": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
