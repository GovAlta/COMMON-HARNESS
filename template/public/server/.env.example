# =============================================================================
# Server Environment Variables
# Copy to .env in this directory: cp .env.example .env
# =============================================================================

# --- Core ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://user:PASSWORD@localhost:5432/myapp_dev

# --- Client serving ---
# When true (or NODE_ENV=production), Express serves client/dist/ as static files.
# In dev, leave false and run the Vite dev server separately (npm run dev:all).
SERVE_CLIENT=false

# --- URLs ---
# CORS_ORIGIN: allowed origins for CORS and OAuth redirects.
#   Dev:  http://localhost:5173 (Vite dev server)
#   Prod: https://your-app.onrender.com (same URL the app is served from)
CORS_ORIGIN=http://localhost:5173

# API_BASE_URL: public-facing URL of this server, used to build OAuth callback URLs.
#   Dev:  http://localhost:3000
#   Prod: https://your-app.onrender.com
API_BASE_URL=http://localhost:3000

# --- JWT (RS256 asymmetric keys) ---
# Dev: optional — generate PEM files with: npm run generate-keys
#   Keys are stored in server/keys/ and loaded automatically.
# Prod: REQUIRED — provide PEM keys via env vars (from Key Vault / secrets manager).
#   All four must be set and start with "-----BEGIN".
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_REFRESH_PRIVATE_KEY=
JWT_REFRESH_PUBLIC_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CSRF ---
# Minimum 32 characters, used for HMAC signing of CSRF tokens
CSRF_SECRET=  # set to a 32+ char random string

# --- OAuth SSO: Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth SSO: Microsoft ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Single-tenant GUID required in production. environment.ts rejects the
# multi-tenant values 'common', 'organizations', 'consumers' when
# NODE_ENV=production because they let ANY Microsoft account in the world
# authenticate (CAS IDPV-001 Critical). The OIDC callback also verifies the
# `tid` claim equals this value — tokens from other tenants are rejected even
# when the JWT signature passes. Leave empty to disable Microsoft SSO.
MICROSOFT_TENANT_ID=

# --- AI / LLM ---
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=1024

# --- Database pool ---
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# --- Rate limiting ---
RATE_LIMIT_API_MAX=200
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=60
RATE_LIMIT_AI_WINDOW_MS=3600000
# Broadcast — each call fans out to every active user (N inserts + N SSE
# writes). Tighter cap protects the DB / SSE manager from a compromised
# admin token. Default: 60 / hour / IP.
RATE_LIMIT_BROADCAST_MAX=60
RATE_LIMIT_BROADCAST_WINDOW_MS=3600000

# --- Request body size limits ---
BODY_LIMIT_JSON=1mb
BODY_LIMIT_URLENCODED=1mb

# --- Graceful shutdown ---
SHUTDOWN_TIMEOUT_MS=30000

# --- File upload extension points ---
# Malware scanner adapter. 'noop' (default) accepts everything — risk-accepted
# as RA-FS-001 for templates that don't accept user uploads. For production
# deploys that DO accept uploads, set to 'clamav' / 'defender' / 'custom' and
# wire in the adapter in server/src/services/file-scanner.ts.
FILE_SCANNER=noop
# Storage backend adapter. 'database' (default) writes file bytes into the
# Postgres BYTEA column — pg_dump backups cover the files automatically.
# Set to 'sharepoint' / 'azure-blob' / 's3' and wire adapter in file-store.ts
# when scaling beyond BYTEA.
FILE_STORE=database

# --- Protected B data encryption (OPT-IN) ---
# Required only when migration 020_optional_pgcrypto.sql is enabled. See
# docs/dr/protected-b-encryption.md for the full procedure. Generate a key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store in your secrets manager and inject at runtime; do NOT commit a value.
PGCRYPTO_DATA_KEY=

# --- Disaster recovery (consumed by scripts/backup.sh) ---
# BACKUP_DIR=./backups     # where pg_dump writes
# BACKUP_RETAIN=7          # number of dumps to keep
# ALLOW_PROD_RESTORE=false # safety guard on scripts/restore.sh
