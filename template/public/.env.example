# ============================================
# Application Template
# Environment Configuration
# ============================================
# This file documents all available environment variables.
# The server loads .env from the server/ directory (see server/.env.example).
# Copy server/.env.example to server/.env for local development.

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://user:PASSWORD@localhost:5432/app_template
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# CORS — Comma-separated list of allowed origins.
# Dev: the Vite dev server origin.
# Prod: set to the domain the app is served on (same-origin when SERVE_CLIENT=true).
# Also used to derive the frontend redirect URL for OAuth callbacks.
CORS_ORIGIN=http://localhost:5173

# API_BASE_URL — public-facing URL of the backend server.
# Used to build OAuth callback URLs (Google/Microsoft redirect back to this URL).
# Dev:  http://localhost:3000
# Prod: https://your-app.onrender.com (same domain as the app)
API_BASE_URL=http://localhost:3000

# Serve client/dist from the Express server (production mode).
# Set to 'true' or set NODE_ENV=production to enable.
# SERVE_CLIENT=true

# Rate Limiting — all configurable, no hardcoded values.
# RATE_LIMIT_API_MAX=200              # General API: max requests per window
# RATE_LIMIT_API_WINDOW_MS=900000     # General API: window in ms (default 15 min)
# RATE_LIMIT_AUTH_MAX=30              # Auth/SSO endpoints: max requests per window
# RATE_LIMIT_AUTH_WINDOW_MS=900000    # Auth/SSO: window in ms (default 15 min)
# RATE_LIMIT_AI_MAX=60                # AI endpoints: max requests per window
# RATE_LIMIT_AI_WINDOW_MS=3600000     # AI: window in ms (default 1 hour)

# JWT Configuration (RS256 asymmetric keys)
# Development: generate PEM files with: cd server && npm run generate-keys
#   Keys are stored in server/keys/ and loaded automatically by token.ts.
# Production: inject PEM keys as env vars from Key Vault / secrets manager.
# JWT_PRIVATE_KEY=<PEM string from Key Vault>
# JWT_PUBLIC_KEY=<PEM string from Key Vault>
# JWT_REFRESH_PRIVATE_KEY=<PEM string from Key Vault>
# JWT_REFRESH_PUBLIC_KEY=<PEM string from Key Vault>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CSRF — minimum 32 characters, used for HMAC signing of CSRF tokens
# CSRF_SECRET=  # set to a 32+ char random string

# SSO Configuration
# Callback URLs to register with the OAuth providers:
#   Google:    {API_BASE_URL}/api/auth/google/callback
#   Microsoft: {API_BASE_URL}/api/auth/microsoft/callback
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_TENANT_ID=common

# AI Configuration (Phase 8)
# AI_PROVIDER=openai
# AI_API_KEY=your-ai-api-key
# AI_MODEL=gpt-4o-mini
# AI_MAX_TOKENS=1024

# Request Body Size Limits
# BODY_LIMIT_JSON=1mb
# BODY_LIMIT_URLENCODED=1mb

# Graceful Shutdown
# SHUTDOWN_TIMEOUT_MS=30000
